{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 15 },
    "color": { "keys": "#F5A623" }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#7FD4EC",
        "host": "#FFD23F",
        "at": "#B8A9C9"
      }
    },
    {
      "type": "separator",
      "string": "󰯊 ─────────────────────────",
      "keyColor": "#C24B8F"
    },
    { "type": "os",        "key": "󰣇 os" },
    { "type": "host",      "key": "󰌢 host" },
    { "type": "kernel",    "key": "󰌽 kernel" },
    { "type": "uptime",    "key": "󰅐 uptime" },
    { "type": "packages",  "key": "󰏖 packages" },
    { "type": "shell",     "key": "󱆃 shell" },
    { "type": "display",   "key": "󰍹 display" },
    { "type": "de",        "key": "󰧨 de" },
    { "type": "wm",        "key": "󱂬 wm" },
    { "type": "wmtheme",   "key": "󰉼 wmtheme" },
    { "type": "theme",     "key": "󰏘 theme" },
    { "type": "icons",     "key": "󰀻 icons" },
    { "type": "font",      "key": "󰛖 font" },
    { "type": "cursor",    "key": "󰇀 cursor" },
    { "type": "terminal",  "key": "󰄛 terminal" },
    { "type": "terminalfont", "key": "󰛖 ttyfont" },
    { "type": "cpu",       "key": "󰻠 cpu" },
    { "type": "gpu",       "key": "󰢮 gpu" },
    { "type": "memory",    "key": "󰍛 memory" },
    { "type": "swap",      "key": "󰓡 swap" },
    { "type": "disk",      "key": "󰋊 disk" },
    { "type": "battery",   "key": "󰁹 battery" },
    { "type": "poweradapter", "key": "󰚥 power" },
    { "type": "localip",   "key": "󰩟 local ip" },
    { "type": "locale",    "key": "󰗊 locale" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 3 },
    { "type": "colors", "symbol": "diamond", "paddingLeft": 3 }
  ]
  // Spider-Man: Brand New Day — paleta do design/DESIGN.md:
  // roxo-noite #1A0F2E · vermelho do traje #B52330 · dourado #F5A623/#FFD23F ·
  // magenta das teias #C24B8F · ciano do brilho dos olhos #7FD4EC
  //
  // Logo: "arch" — logo oficial do Arch Linux embutida no fastfetch (variante
  // pequena). spiderman.ans segue no diretório, bastando apontar o source de
  // volta para ele para recuperar o tema Spider-Man.
  //
  // A paleta dos módulos/keys ainda é a do design/DESIGN.md do Spider-Man
  // (roxo-noite #1A0F2E · vermelho #B52330 · dourado #F5A623/#FFD23F ·
  // magenta #C24B8F · ciano #7FD4EC), independente da logo.
}